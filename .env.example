# --- Резервная доставка заявок ботом (необязательно) ---
# Основной канал: формы открывают пользователю чат t.me/pinpiece с готовым текстом
# заявки (адрес — TELEGRAM_USERNAME в lib/telegram.ts). Параллельно данные дублируются
# на /api/lead: если заданы обе переменные — уходят в чат/канал бота, иначе в лог сервера.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Яндекс.Метрика (необязательно) ---
# По умолчанию используется счётчик 112993063 (зашит в коде).
# Переопределите здесь, если нужен другой номер счётчика.
NEXT_PUBLIC_YM_ID=
